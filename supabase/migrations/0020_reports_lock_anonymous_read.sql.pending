-- NOT APPLIED. Apply this only after SUPABASE_SERVICE_ROLE_KEY is set in
-- every environment (local .env.local and Vercel), and after switching
-- src/app/report/[id]/page.tsx and src/app/report/actions.ts to
-- createServiceClient().
--
-- Why: the Supabase anon key ships in the browser bundle, so anyone can call
-- the REST API with it. While anonymous reports are SELECT-able by anon, a
-- request like
--   GET /rest/v1/reports?profile_id=is.null&select=*
-- returns every anonymous report — business name, revenue range, pain points
-- and goals of real prospects. Individual links are unguessable UUIDs; the
-- problem is bulk listing, which RLS alone cannot prevent.
--
-- Reads must move to the service role first, or the report page and the
-- anonymous report funnel break.

drop policy if exists "reports_select_anonymous" on public.reports;
drop policy if exists "report_recs_select_anonymous" on public.report_recommendations;
